# URL del backend. Si se deja vacía, en desarrollo la API pasa por el proxy de Metro (metro.config.js).
# Ejemplo para el despliegue: EXPO_PUBLIC_API_URL=https://api.tu-dominio.com
EXPO_PUBLIC_API_URL=
# Origen opcional de la web pública, no el host de la API. Sin configurar se usa la web oficial indicada abajo.
# En desarrollo: http://localhost:5173 o IP privada LAN (el navegador del médico debe poder alcanzar este host).
EXPO_PUBLIC_WEB_URL=https://yuyay-frontend.vercel.app
# ID de cliente **web** de Google (el mismo de VITE_GOOGLE_CLIENT_ID y GOOGLE_CLIENT_IDS del backend).
# Sin él, o en Expo Go, el botón de Google no aparece. Ver docs/google-mobile.md.
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
