{
  "expo": {
    "name": "Yuyay",
    "slug": "yuyay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "automatic",
    "backgroundColor": "#F0FAFC",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.yuyay.mobile"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#96C1C5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.MODIFY_AUDIO_SETTINGS",
        "android.permission.FOREGROUND_SERVICE",
        "android.permission.FOREGROUND_SERVICE_MEDIA_PLAYBACK"
      ],
      "package": "com.yuyay.mobile"
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "cameraPermission": "Yuyay usa la cámara para fotografiar recetas y documentos médicos.",
          "photosPermission": "Yuyay usa tus fotos para subir recetas y documentos médicos."
        }
      ],
      [
        "expo-location",
        {
          "locationWhenInUsePermission": "Yuyay usa tu ubicación para mostrarte clínicas y hospitales cercanos."
        }
      ],
      [
        "expo-audio",
        {
          "microphonePermission": "Yuyay usa el micrófono para grabar notas de voz sobre la persona a tu cuidado."
        }
      ]
    ],
    "extra": {
      "eas": {
        "projectId": "5bbe1966-f04a-4da4-b8ef-dc6ab440698d"
      }
    },
    "owner": "aprilwu-mobile",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/5bbe1966-f04a-4da4-b8ef-dc6ab440698d"
    }
  }
}
