{
  "expo": {
    "name": "Yuyay",
    "slug": "yuyay-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "backgroundColor": "#EEF6F7",
    "ios": {
      "supportsTablet": true
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#96C1C5",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-font",
      "expo-secure-store",
      "expo-document-picker",
      [
        "expo-image-picker",
        {
          "photosPermission": "Permite a Yuyay seleccionar imágenes para los documentos de la persona que cuidas.",
          "cameraPermission": "Permite a Yuyay fotografiar recetas y documentos de la persona que cuidas.",
          "microphonePermission": false
        }
      ]
    ]
  }
}
